{
  "name": "true-goshen-auto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "images": "npx tsx scripts/export-slugs.ts && node scripts/download-car-images.mjs --force",
    "db:seed": "npx tsx scripts/generate-supabase-seed.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run src/lib/security/__tests__",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check:migrations": "node scripts/check-migrations.mjs",
    "load:smoke": "node scripts/load-smoke.mjs",
    "logo": "node scripts/process-logo.mjs",
    "letterhead": "node scripts/export-letterhead.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "countries:generate": "npx tsx scripts/generate-countries-data.ts",
    "lighthouse:home": "npx lighthouse https://www.truegoshengh.com --only-categories=performance,accessibility,best-practices,seo --output=html --output-path=./lighthouse-home.html --chrome-flags=\"--headless\"",
    "lighthouse:platform": "npx lighthouse https://www.truegoshengh.com/platform/dashboard --only-categories=performance,accessibility,best-practices --output=html --output-path=./lighthouse-platform-dashboard.html --chrome-flags=\"--headless\""
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@google/generative-ai": "^0.24.1",
    "@sentry/nextjs": "^10.68.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.19",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.0",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.11.0",
    "sharp": "^0.35.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@serwist/turbopack": "^9.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "pdfjs-dist": "^6.2.108",
    "serwist": "^9.5.11",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
