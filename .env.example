# Supabase (required for production — Auth + database)
# Until auth.nabusmotors.com Custom Domain HTTPS is healthy, use:
#   NEXT_PUBLIC_SUPABASE_URL=https://ddrknhvkhmgdtavpuiiq.supabase.co
# After Custom Domain is Active + healthy:
#   NEXT_PUBLIC_SUPABASE_URL=https://auth.nabusmotors.com
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only — never expose in client bundles
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Optional server-side aliases (used if NEXT_PUBLIC_* are unset during build)
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbG...

# Public site origin for invites, emails, metadata, OAuth callback fallback.
# Set to your Vercel deployment URL until custom domain is ready.
NEXT_PUBLIC_SITE_URL=https://www.nabusmotors.com
# Emergency only while custom DNS is broken (do not leave set for launch):
# PUBLIC_SITE_URL_EMERGENCY_FALLBACK=https://nabus-motors.vercel.app

# Customer Google OAuth (Supabase Auth → Providers → Google)
# Google redirect URI (always keep): https://ddrknhvkhmgdtavpuiiq.supabase.co/auth/v1/callback
# Optional branded: https://auth.nabusmotors.com/auth/v1/callback (only when Custom Domain healthy)
# Paste Client ID + Secret in Supabase dashboard (not Next.js env vars).
# Full guide: docs/GOOGLE_AUTH.md · Custom domain: docs/SUPABASE_AUTH_DOMAIN.md
# Signup email checks (format / disposable / MX): docs/EMAIL_VALIDATION.md

# Auto Division direct entry (optional; used for auto-specific links)
# NEXT_PUBLIC_AUTO_SITE_URL=https://www.nabusmotors.com
# Hostnames that route straight to /auto (comma-separated)
# AUTO_DIVISION_HOSTS=nabusmotors.com,nabus-motors.vercel.app,auto.truegoshen.com
NEXT_PUBLIC_WHATSAPP_NUMBER=233279940200

# Platform invite emails (Resend — https://resend.com)
# Sending domain can stay nabusmotors.com once Resend-verified (email DNS ≠ web DNS).
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=noreply@nabusmotors.com

# Customer WhatsApp notifications (choose Twilio OR Meta Cloud API)
# Required for automatic quote-reference WhatsApp messages after freight form submit.
# Without these, messages are logged as "deferred" in notification_log for manual follow-up.
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_WHATSAPP_FROM=+14155238886
# WHATSAPP_PROVIDER=meta
# WHATSAPP_ACCESS_TOKEN=your_meta_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# Alternative SMS/WhatsApp provider
# NOTIFICATION_PROVIDER=termii
# TERMII_API_KEY=your_termii_api_key
# TERMII_BASE_URL=https://api.ng.termii.com
# TERMII_SENDER_ID=TrueGoshen
# TERMII_WHATSAPP_DEVICE_ID=your_device_id
# Or configure API keys in Platform → Settings (owner only)

# Hidden admin portal (NOT linked on public website)
ADMIN_PATH=admin
ADMIN_PASSWORD=change-this-strong-password
# Required: signs owner and team sessions. Generate a unique high-entropy value.
ADMIN_SECRET=change-this-random-secret-string
# OWNER_EMAIL=owner@example.com

# Admin passkeys (WebAuthn / FIDO2) — team accounts only; owner uses ADMIN_PASSWORD
# RP ID must match the hostname users open (www canonical).
WEBAUTHN_RP_ID=www.nabusmotors.com
WEBAUTHN_RP_NAME=Nabus Motors Admin
NEXT_PUBLIC_WEBAUTHN_ENABLED=true

# Account deletion lifecycle
# Retention period before permanent anonymization (default 30 days)
ACCOUNT_DELETION_RETENTION_DAYS=30
NEXT_PUBLIC_ACCOUNT_DELETION_RETENTION_DAYS=30
# Max deletion attempts per user per hour (default 5)
ACCOUNT_DELETION_RATE_LIMIT=5
# Vercel Cron auth secret for /api/cron/account-deletion-cleanup
CRON_SECRET=change-this-cron-secret

# AI listing assistant (Google Gemini via AI Studio — key must start with AIzaSy)
# Create at https://aistudio.google.com/apikey (not Vertex AI / Google Cloud console keys)
# Required for TEXT editing in the AI Editor (descriptions, fields, etc.)
# Also enables soft-gate checks on inventory image uploads (warns when a photo does not
# look like a vehicle; admins can still confirm “This is intentional” and upload).
# Without GEMINI_API_KEY, image uploads fail-open (allowed) and the check is skipped.
GEMINI_API_KEY=your_gemini_api_key
# Optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
# Alternative env name also supported:
# GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key

# Stock photos in the AI Editor use curated Pexels CDN URLs (no API key required).
# PEXELS_API_KEY is NOT needed for this project.

# Optional Cloudinary delivery transforms (public account identifier, not a secret)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# PWA / Web Push (optional — required only when enabling push notifications)
# Generate keys: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_SUBJECT=mailto:ops@truegoshen.com

# EMERGENCY FALLBACKS ONLY — approximate mid-market (GHS ≈ 11.19). Live rates come from
# /api/exchange-rates (open.er-api.com). Prefer leaving these unset in production so
# code defaults apply when the live API is unreachable; never treat them as live FX.
NEXT_PUBLIC_USD_TO_GHS=11.19
NEXT_PUBLIC_USD_TO_ZIG=26.63
NEXT_PUBLIC_USD_TO_ZAR=15.94
NEXT_PUBLIC_USD_TO_NGN=1351
NEXT_PUBLIC_USD_TO_KES=129.5
NEXT_PUBLIC_USD_TO_GBP=0.73
NEXT_PUBLIC_USD_TO_EUR=0.86

# Live FX (ExchangeRate-API). Open access needs no key; optional paid key for higher limits:
# https://www.exchangerate-api.com
# EXCHANGE_RATE_API_KEY=your_exchangerate_api_key
# Server-only. Never expose this key to the browser.
# Rates refresh about every 30 minutes. NEXT_PUBLIC_USD_TO_* values above are
# emergency fallbacks when both the live API and last-good DB cache are down.

# Sentry error monitoring (optional locally; required in production for Issues)
# Create a Next.js project at https://sentry.io — copy Client Keys (DSN).
# Use the SAME DSN for both vars. Redeploy after setting NEXT_PUBLIC_* on Vercel.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oNNNN.ingest.sentry.io/MMMM
# SENTRY_DSN=https://xxxx@oNNNN.ingest.sentry.io/MMMM
# SENTRY_ENVIRONMENT=production
# Optional source-map upload during `next build` (never commit the auth token):
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=nabus-motors
# SENTRY_AUTH_TOKEN=sntrys_...
# Optional Session Replay (off by default):
# NEXT_PUBLIC_SENTRY_REPLAY=true
