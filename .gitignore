# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.supabase-restore.example

# local color-audit artifacts (may include scraped inventory URLs)
scripts/.inventory-*
scripts/.photo-color-samples.json

# vercel
.vercel

# vehicle photos — generated at build (one per slug)
/public/vehicles/cars/*.jpg

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# credentials / recovery codes
*recovery-codes*.txt
*recovery_codes*.txt
*.key
*.p12
*.pfx
*service-account*.json
*credentials*.json

# local verification & deploy scratch output
*.log
verify-*.log
tsc-*.txt
build-output.txt
build-charts-fix.txt
vercel-*-deploy*.txt
vercel-deploy*.txt
lighthouse-*.json
lighthouse-*.html
git-push-progress.txt
pinterest-video-urls.txt
